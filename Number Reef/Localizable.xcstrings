        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Superbonuss darbojas, līdz trāpi nepareizā atbildē. Tad zaudē tikai pusi dzīvības. Lai veicas!"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Супербонусот трае додека не удриш погрешен одговор. Тогаш губиш само половина живот. Со среќа!"
