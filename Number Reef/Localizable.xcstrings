        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "වැරදි පිළිතුරක් හැපෙනකම් සුපිරි බෝනස් එක තියෙනවා. එතකොට අහිමි වෙන්නේ ජීවිත භාගයක් විතරයි. ජය වේවා!"
          }
        },
        "sk": {
          "stringUnit": {
