        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Магазин сейчас недоступен. Попробуйте позже."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "වෙළඳසැල දැන් ලබාගත නොහැක. පසුව නැවත උත්සාහ කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
