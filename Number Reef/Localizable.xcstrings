        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სუპერბონუსი მოქმედებს, სანამ არასწორ პასუხს არ შეეხები. მერე მხოლოდ ნახევარ სიცოცხლეს დაკარგავ. წარმატებები!"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Супербонус қате жауапқа тигенше жалғасады. Сонда тек жарты өмір жоғалтасың. Сәттілік!"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស៊ុបព័របូណូសនៅតែដំណើរការ រហូតដល់អ្នកបុកចម្លើយខុស។ បន្ទាប់មក អ្នកបាត់តែកន្លះជីវិត។ សំណាងល្អ!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತಪ್ಪು ಉತ್ತರಕ್ಕೆ ತಾಕುವವರೆಗೆ ಸೂಪರ್ ಬೋನಸ್ ಇರುತ್ತದೆ. ನಂತರ ಅರ್ಧ ಜೀವ ಮಾತ್ರ ಕಳೆದುಕೊಳ್ಳುತ್ತೀಯ. ಶುಭವಾಗಲಿ!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슈퍼 보너스는 오답에 닿을 때까지 계속돼요. 그러면 목숨은 반 개만 잃어요. 힘내요!"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຊູເປີໂບນັດຈະຢູ່ຈົນກວ່າເຈົ້າຊົນຄຳຕອບຜິດ. ແລ້ວເຈົ້າຈະເສຍແຕ່ເຄິ່ງຊີວິດ. ໂຊກດີ!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpremija veikia, kol palieti neteisingą atsakymą. Tada prarandi tik pusę gyvybės. Sėkmės!"
