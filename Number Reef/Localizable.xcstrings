          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, මිනිත්තු %2$lld / %3$lld, දින %4$lldක් පේළියට"
          }
        },
        "sk": {
          "stringUnit": {
