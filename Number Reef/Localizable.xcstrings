        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze nowe zadania do ćwiczeń."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre novas contas para praticar."
          }
        },
        "ro": {
