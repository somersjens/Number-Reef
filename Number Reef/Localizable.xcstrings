    "levelIntro.addition.intro": {
      "comment": "First line of the level intro card for Addition, saying what the sums do. Emphasise the operation with Markdown **bold**, wherever it falls in your sentence.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Somme waar jy 'n getal \\*\\*optel\\*\\*."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቁጥርን **የምትደምርባቸው** ስሌቶች።"
