        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süper bonus, yanlış bir cevaba çarpana kadar sürer. Sonra sadece yarım can kaybedersin. Bol şans!"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
