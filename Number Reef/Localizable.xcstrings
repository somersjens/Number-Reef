    "levelIntro.subtraction.intro": {
      "comment": "First line of the level intro card for Subtraction. Emphasise the operation with Markdown **bold**, wherever it falls in your sentence.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Somme waar jy 'n getal \\*\\*aftrek\\*\\*."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቁጥርን **የምትቀንስባቸው** ስሌቶች።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسائل **تطرح** فيها عددًا."
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "য’ত তুমি এটা সংখ্যা **বিয়োগ** কৰা অংক।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ədədi **çıxdığın** misallar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прыклады, дзе трэба **адняць** лік."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, в които **изваждаш** число."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব অঙ্কে একটি সংখ্যা **বিয়োগ** করো।"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "གྲངས་ཤིག **འཐེན་པའི** རྩིས།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaci gdje broj **oduzimaš**."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumes on **restes** un nombre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příklady, kde číslo **odečítáš**."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Symiau lle rwyt ti’n **tynnu** rhif."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Regnestykker, hvor du **trækker et tal fra**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben, bei denen du eine Zahl **abziehst**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ασκήσεις όπου **αφαιρείς** έναν αριθμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sums where you **take away** a number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumas en las que **restas** un número."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehted, kus sa arvu **lahutad**."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zenbaki bat \\*\\*kentzen\\*\\* duten eragiketak."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرین‌هایی که در آن عددی را **کم** می‌کنی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
