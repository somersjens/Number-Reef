          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap haiwan membawa tema warnanya sendiri ke seluruh permainan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "တိရစ္ဆာန်တစ်ကောင်စီက ဂိမ်းတစ်ခုလုံးကို သူ့အရောင်ပုံစံနဲ့ ပြောင်းပေးတယ်။"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "हरेक जनावरले पूरै खेलमा आफ्नै रङको थिम ल्याउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk dier geeft het hele spel zijn eigen kleurenthema."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert dyr gir hele spillet sitt eget fargetema."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ପଶୁ ସମ୍ପୂର୍ଣ୍ଣ ଖେଳକୁ ନିଜର ରଙ୍ଗୀନ ଥିମ୍ ଦିଏ।"
