    "premium.feature.animals.subtitle %lld": {
      "comment": "Explains the second Premium selling point. The argument is the total number of animals in the game.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "new",
            "value": "With premium you play freely with all %#@animals@."
          },
          "substitutions": {
            "animals": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "new",
                      "value": "%arg animal"
                    }
