        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซูเปอร์โบนัสจะทำงานจนกว่าจะชนคำตอบผิด แล้วจะเสียแค่ครึ่งชีวิต ขอให้สนุก!"
