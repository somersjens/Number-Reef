    "parentGate.subtitle": {
      "comment": "Explains to the adult why the check exists, immediately under parentGate.title.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Om jong spelers te beskerm, moet ’n volwassene dié toets voltooi voordat die aankoop kan voortgaan."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ትንንሽ ተጫዋቾችን ለመጠበቅ፣ ወደ ግዢው ከመቀጠል በፊት አንድ አዋቂ ይህን ማረጋገጫ ማጠናቀቅ አለበት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحماية اللاعبين الصغار، يجب أن يُكمل شخص بالغ هذا التحقق قبل متابعة الشراء."
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "সৰু খেলুৱৈক সুৰক্ষিত ৰাখিবলৈ ক্ৰয়ৰ আগতে এজন ডাঙৰে এই পৰীক্ষা সম্পূৰ্ণ কৰিব লাগিব।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaca oyunçuları qorumaq üçün alışa davam etməzdən əvvəl bir böyük bu yoxlamanı tamamlamalıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
