    "streak.accessibility.choosePeriod": {
      "comment": "VoiceOver hint for the streak chip, saying that tapping it opens the play-goal sheet.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies ’n daaglikse of weeklikse doel"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የቀን ወይም የሳምንት ግብ ምረጥ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر هدفًا يوميًا أو أسبوعيًا"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "দৈনিক বা সাপ্তাহিক লক্ষ্য বাছা"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gündəlik və ya həftəlik hədəf seç"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберы штодзённую або штотыднёвую мэту"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Избери дневна или седмична цел"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দৈনিক বা সাপ্তাহিক লক্ষ্য বেছে নাও"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཉིན་རེའམ་བདུན་རེའི་དམིགས་ཡུལ་འདེམས།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izaberi dnevni ili sedmični cilj"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria un objectiu diari o setmanal"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber denní nebo týdenní cíl"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dewis nod dyddiol neu wythnosol"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et dagligt eller ugentligt mål"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Tages- oder Wochenziel"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε καθημερινό ή εβδομαδιαίο στόχο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
