    "onboarding.level.title": {
      "comment": "Headline on the starting-difficulty onboarding screen. Addressed to the child, and deliberately unintimidating.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe goed is jy al hiermee?"
