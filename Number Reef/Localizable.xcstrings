    "levelIntro.mixed.intro": {
      "comment": "First line of the level intro card for Supermix, listing the operations it mixes. Emphasise the opening phrase with Markdown **bold**.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "\\*\\*Alles gemeng\\*\\*: plus, minus, maal, breuke en persentasies."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "**ሁሉም ተቀላቅሎ**፦ መደመር፣ መቀነስ፣ ማባዛት፣ ክፍልፋይ እና መቶኛ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**كل شيء مختلط**: جمع، طرح، ضرب، كسور ونِسَب مئوية."
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "**সকলো মিহলি**: যোগ, বিয়োগ, পূৰণ, ভগ্নাংশ আৰু শতাংশ।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hamısı qarışıq**: toplama, çıxma, vurma, kəsrlər və faizlər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "**Усё ўперамешку**: плюс, мінус, множанне, дробы і працэнты."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "**Всичко смесено**: плюс, минус, умножение, дроби и проценти."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "**সব মিশিয়ে**: যোগ, বিয়োগ, গুণ, ভগ্নাংশ ও শতাংশ।"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "**ཚང་མ་མཉམ་བསྲེས**: སྣོན། འཐེན། སྒྱུར། ཆ་ཤས། བརྒྱ་ཆ།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sve pomiješano**: plus, minus, puta, razlomci i procenti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tot barrejat**: sumar, restar, multiplicar, fraccions i percentatges."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Všechno dohromady**: plus, mínus, krát, zlomky a procenta."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "**Popeth yn gymysg**: adio, tynnu, lluosi, ffracsiynau a chanrannau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Alt blandet**: plus, minus, gange, brøker og procenter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Alles gemischt**: Plus, Minus, Mal, Brüche und Prozente."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Όλα μαζί**: πρόσθεση, αφαίρεση, πολλαπλασιασμός, κλάσματα και ποσοστά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Everything mixed**: plus, minus, times, fractions and percentages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Todo mezclado**: sumar, restar, multiplicar, fracciones y porcentajes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kõik segamini**: liitmine, lahutamine, korrutamine, murrud ja protsendid."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "\\*\\*Dena nahastuta\\*\\*: batuketak, kenketak, biderketak, zatikiak eta ehunekoak."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "**همه باهم**: جمع، تفریق، ضرب، کسر و درصد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kaikki sekaisin**: plus, miinus, kerto, murtoluvut ja prosentit."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "**Alt blandað**: pluss, minus, ferðir, brot og prosent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tout mélangé** : plus, moins, fois, fractions et pourcentages."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gach rud measctha**: móide, lúide, iolrú, codáin agus céatadáin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "\\*\\*Todo mesturado\\*\\*: sumar, restar, multiplicar, fraccións e porcentaxes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "**બધું મિક્સ**: સરવાળો, બાદબાકી, ગુણાકાર, અપૂર્ણાંક અને ટકા."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "**הכול מעורבב**: חיבור, חיסור, כפל, שברים ואחוזים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**सब मिला-जुला**: जोड़, घटाव, गुणा, भिन्न और प्रतिशत।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sve pomiješano**: plus, minus, puta, razlomci i postoci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "**Minden vegyesen**: plusz, mínusz, szorzás, törtek és százalékok."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ամեն ինչ խառնված**՝ գումարում, հանում, բազմապատկում, կոտորակներ ու տոկոսներ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\\*\\*Semua campur\\*\\*: tambah, kurang, kali, pecahan, dan persen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "**Allt í bland**: plús, mínus, margföldun, brot og prósentur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tutto mescolato**: più, meno, per, frazioni e percentuali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\\*\\*ぜんぶミックス\\*\\*: たし算、ひき算、かけ算、分数、パーセント。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "\\*\\*ყველაფერი არეული\\*\\*: პლუსი, მინუსი, გამრავლება, წილადები და პროცენტები."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Бәрі аралас**: қосу, азайту, көбейту, бөлшектер мен пайыздар."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "**ចម្រុះទាំងអស់**៖ បូក ដក គុណ ប្រភាគ និងភាគរយ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "**ಎಲ್ಲವೂ ಮಿಶ್ರ**: ಪ್ಲಸ್, ಮೈನಸ್, ಗುಣಾಕಾರ, ಭಿನ್ನರಾಶಿ ಮತ್ತು ಶೇಕಡಾ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**모두 섞어서**: 덧셈, 뺄셈, 곱셈, 분수, 백분율."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "**ປົນກັນໝົດ**: ບວກ, ລົບ, ຄູນ, ເສດສ່ວນ ແລະ ເປີເຊັນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Viskas sumaišyta**: pliusas, minusas, daugyba, trupmenos ir procentai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Viss sajaukts**: plusi, mīnusi, reizināšana, daļas un procenti."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Сè измешано**: плус, минус, множење, дропки и проценти."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "**എല്ലാം കലർത്തി**: കൂട്ടൽ, കുറയ്ക്കൽ, ഗുണനം, ഭിന്നങ്ങൾ, ശതമാനം."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "**Бүгд холилдоно**: нэмэх, хасах, үржих, бутархай, хувь."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\\*\\*सगळे मिसळून\\*\\*: बेरीज, वजाबाकी, गुणाकार, अपूर्णांक आणि टक्केवारी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "**Semua bercampur**: tambah, tolak, darab, pecahan dan peratus."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "**အားလုံးရော**: ပေါင်း၊ နုတ်၊ မြှောက်၊ အပိုင်းကိန်းနဲ့ ရာခိုင်နှုန်း။"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "**सबै मिसाएर**: जोड, घटाउ, गुणा, भिन्न र प्रतिशत।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Alles door elkaar**: plus, min, keer, breuken en procenten."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "**Alt blandet**: pluss, minus, gange, brøk og prosent."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "**ସବୁ ମିଶିତ**: ଯୋଗ, ବିୟୋଗ, ଗୁଣ, ଭଗ୍ନାଂଶ ଓ ଶତକଡ଼ା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "**ਸਭ ਕੁਝ ਮਿਲਿਆ-ਜੁਲਿਆ**: ਜੋੜ, ਘਟਾਓ, ਗੁਣਾ, ਭਿੰਨਾਂ ਤੇ ਪ੍ਰਤੀਸ਼ਤ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Wszystko razem**: plus, minus, razy, ułamki i procenty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tudo misturado**: somar, subtrair, multiplicar, frações e percentagens."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "**Totul amestecat**: plus, minus, ori, fracții și procente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\\*\\*Всё вперемешку\\*\\*: плюс, минус, умножение, дроби и проценты."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "**හැම දෙයක්ම මිශ්‍රයි**: එකතු, අඩු, ගුණ, භාග සහ ප්‍රතිශත."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Všetko zmiešané**: plus, mínus, násobenie, zlomky a percentá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vse pomešano**: plus, minus, krat, ulomki in odstotki."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gjithçka përzier**: plus, minus, shumëzim, thyesa dhe përqindje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sve pomešano**: sabiranje, oduzimanje, množenje, razlomci i procenti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Allt blandat**: plus, minus, gånger, bråk och procent."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mchanganyiko wote**: jumlisha, toa, zidisha, sehemu na asilimia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "**எல்லாம் கலந்து**: கூட்டல், கழித்தல், பெருக்கல், பின்னங்கள், சதவீதங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "**అన్నీ కలిపి**: కూడిక, తీసివేత, గుణకారం, భిన్నాలు, శాతాలు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**รวมทุกอย่าง**: บวก ลบ คูณ เศษส่วน และเปอร์เซ็นต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hepsi karışık**: artı, eksi, çarpma, kesir ve yüzde."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "**ھەممىسى ئارىلاش**: قوشۇش، ئېلىش، كۆپەيتىش، كەسىر ۋە پىرسەنت."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\\*\\*Усе впереміш\\*\\*: плюс, мінус, множення, дроби й відсотки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "**سب ملا جلا**: جمع، تفریق، ضرب، کسر اور فیصد۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hammasi aralash**: qo‘shish, ayirish, ko‘paytirish, kasr va foizlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trộn tất cả**: cộng, trừ, nhân, phân số và phần trăm."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "\\*\\*全部混合\\*\\*：加、减、乘、分数和百分数。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "**Konke kuxubene**: hlanganisa, susa, phindaphinda, amafrakshini namaphesenti."
          }
        }
      }
    },
