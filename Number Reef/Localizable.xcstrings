        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සෑම සතෙකුම මුළු ක්‍රීඩාවටම තමන්ගේම වර්ණ තේමාවක් දෙයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé zviera prinesie do celej hry vlastnú farebnú tému."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka žival obarva celotno igro s svojo barvno temo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo kafshë i jep gjithë lojës temën e vet me ngjyra."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka životinja daje celoj igri svoju temu boja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje djur ger hela spelet sitt eget färgtema."
