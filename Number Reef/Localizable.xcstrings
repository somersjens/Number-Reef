    "notif.comeback.body": {
      "comment": "Push notification body after a long absence. Warm, never guilt-inducing.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou diere wag. Kom terug om te speel en hou aan om trofeë in te samel!"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እንስሳትዎ እየጠበቁ ናቸው. ለመጫወት ይመለሱ እና ዋንጫዎችን መሰብሰብዎን ይቀጥሉ!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حيواناتك تنتظر. عد للعب واستمر في جمع الجوائز!"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "তোমাৰ জীৱ-জন্তুবোৰে ৰৈ আছে। খেলিবলৈ উভতি আহক আৰু ট্ৰফী সংগ্ৰহ কৰি থাকিব!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Heyvanlarınız gözləyir. Oynamaq üçün qayıdın və kuboklar toplamağa davam edin!"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашы жывёлы чакаюць. Вяртайцеся гуляць і працягвайце збіраць трафеі!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Животните ви чакат. Върнете се да играете и продължавайте да събирате трофеи!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পশুরা অপেক্ষা করছে। খেলতে ফিরে আসুন এবং ট্রফি সংগ্রহ করতে থাকুন!"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཁྱེད་ཀྱི་སེམས་ཅན་སྒུག་ནས་ཡོད།རྩེད་མོ་རྩེད་པར་ཕྱིར་ལོག་ནས་རྟགས་མ་བསྡུ་རུབ་བྱེད་རོགས།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše životinje čekaju. Vratite se da igrate i nastavite skupljati trofeje!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus animals estan esperant. Torna a jugar i segueix recollint trofeus!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zvířata čekají. Vraťte se ke hře a pokračujte ve sbírání trofejí!"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae eich anifeiliaid yn aros. Dewch yn ôl i chwarae a daliwch ati i gasglu tlysau!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine dyr venter. Kom tilbage for at spille og fortsæt med at samle trofæer!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tiere warten. Komm zurück und sammle weiter Blasen!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ζώα σας περιμένουν. Επιστρέψτε για να παίξετε και συνεχίστε να μαζεύετε τρόπαια!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your animals are waiting. Jump back in and keep collecting bubbles!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus animales te esperan. ¡Vuelve a jugar y sigue consiguiendo burbujas!"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie loomad ootavad. Tulge tagasi mängima ja jätkake karikate kogumist!"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zure animaliak zain daude. Itzuli jolastera eta jarraitu garaikurrak biltzen!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حیوانات شما منتظر هستند. برای بازی برگردید و به جمع آوری غنائم ادامه دهید!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eläimesi odottavat. Tule takaisin pelaamaan ja jatka pokaalien keräämistä!"
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Tíni djór bíða. Kom aftur at spæla og halt áfram at savna steyp!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes animaux t’attendent. Reviens jouer et ramasser des bulles !"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá do chuid ainmhithe ag fanacht. Tar ar ais ag imirt agus lean ort ag bailiú trófaithe!"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus animais están esperando. Volve xogar e segue collendo trofeos!"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા પ્રાણીઓ રાહ જોઈ રહ્યા છે. રમવા માટે પાછા આવો અને ટ્રોફી એકત્રિત કરવાનું ચાલુ રાખો!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיות שלך מחכות. חזור לשחק ולהמשיך לאסוף גביעים!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जानवर इंतज़ार कर रहे हैं. खेलने के लिए वापस आएँ और ट्राफियाँ इकट्ठा करते रहें!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše životinje čekaju. Vratite se igrati i nastavite skupljati trofeje!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az állataid várnak. Gyere vissza játszani, és gyűjtsd tovább a buborék!"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր կենդանիները սպասում են:Վերադարձեք խաղալու և շարունակեք գավաթներ հավաքել:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hewan Anda sedang menunggu. Kembalilah bermain dan terus kumpulkan piala!"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dýrin þín bíða. Komdu aftur til að spila og haltu áfram að safna titlum!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi animali ti aspettano. Torna a giocare e raccogli altre bolle!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの動物たちが待っています。再びプレイしてバブルを集め続けましょう!"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი ცხოველები გელოდებიან. დაბრუნდი სათამაშოდ და გააგრძელე თასების შეგროვება!"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сіздің жануарларыңыз күтіп тұр. Ойынға оралыңыз және жүлделерді жинауды жалғастырыңыз!"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សត្វរបស់អ្នកកំពុងរង់ចាំ។ត្រលប់មកលេង ហើយបន្តប្រមូលពានរង្វាន់!"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ರಾಣಿಗಳು ಕಾಯುತ್ತಿವೆ. ಆಡಲು ಹಿಂತಿರುಗಿ ಮತ್ತು ಟ್ರೋಫಿಗಳನ್ನು ಸಂಗ್ರಹಿಸುವುದನ್ನು ಮುಂದುವರಿಸಿ!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 동물들이 기다리고 있습니다. 다시 플레이하고 계속해서 버블을 모아보세요!"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສັດ​ຂອງ​ທ່ານ​ກໍາ​ລັງ​ລໍ​ຖ້າ​. ກັບມາຫຼິ້ນ ແລະເກັບລາງວັນຕໍ່ໄປ!"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų gyvūnai laukia. Grįžkite žaisti ir toliau rinkti trofėjus!"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu dzīvnieki gaida. Atgriezieties spēlēt un turpiniet vākt trofejas!"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите животни чекаат. Вратете се да играте и продолжете да собирате трофеи!"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ മൃഗങ്ങൾ കാത്തിരിക്കുന്നു. കളിക്കാൻ തിരികെ വരിക, ട്രോഫികൾ ശേഖരിക്കുന്നത് തുടരുക!"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны амьтад хүлээж байна. Тоглохоор буцаж ирээд цом цуглуулж байгаарай!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे प्राणी वाट पाहत आहेत. खेळायला परत या आणि ट्रॉफी गोळा करत रहा!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Haiwan anda sedang menunggu. Kembali bermain dan terus mengumpul trofi!"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မင်းရဲ့တိရစ္ဆာန်တွေက စောင့်နေတယ်။ပြန်လာကစားပြီး ဆုဖလားတွေ ဆက်လက်စုဆောင်းလိုက်ပါ။"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंका जनावरहरू पर्खिरहेका छन्। खेल्न फिर्ता आउनुहोस् र ट्रफीहरू सङ्कलन गरिरहनुहोस्!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dieren wachten op je. Spring weer verder en verzamel meer bubbels!"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyrene dine venter. Kom tilbake for å spille og fortsett å samle trofeer!"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ପଶୁମାନେ ଅପେକ୍ଷା କରିଛନ୍ତି |ଖେଳିବାକୁ ଫେରି ଆସ ଏବଂ ଟ୍ରଫି ସଂଗ୍ରହ ଜାରି ରଖ!"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਜਾਨਵਰ ਉਡੀਕ ਕਰ ਰਹੇ ਹਨ। ਖੇਡਣ ਲਈ ਵਾਪਸ ਆਓ ਅਤੇ ਟਰਾਫੀਆਂ ਇਕੱਠੀਆਂ ਕਰਦੇ ਰਹੋ!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zwierzaki czekają. Wróć do gry i zbieraj bąbelki!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus animais estão à espera. Volta a jogar e apanha mais bolhas!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Animalele tale așteaptă. Întoarce-te să joci și continuă să strângi trofee!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои животные ждут. Возвращайся и собирай пузыри!"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ සතුන් බලා සිටී. ක්‍රීඩා කිරීමට නැවත පැමිණ කුසලාන එකතු කර ගන්න!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zvieratá čakajú. Vráťte sa hrať a zbierajte trofeje!"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše živali čakajo. Vrnite se igrat in še naprej zbirajte trofeje!"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafshët tuaja janë duke pritur. Kthehuni për të luajtur dhe vazhdoni të mblidhni trofe!"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше животиње чекају. Вратите се да играте и наставите да сакупљате трофеје!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina djur väntar. Kom tillbaka för att spela och fortsätt samla troféer!"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanyama wako wanasubiri. Rudi kucheza na uendelee kukusanya vikombe!"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் விலங்குகள் காத்திருக்கின்றன. விளையாட மீண்டும் வாருங்கள், கோப்பைகளை சேகரித்துக்கொண்டே இருங்கள்!"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ జంతువులు ఎదురుచూస్తున్నాయి. మళ్లీ వచ్చి ట్రోఫీలు సేకరిస్తూ ఉండు!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัตว์ของคุณกำลังรออยู่กลับมาเล่นสะสมฟองสบู่กันต่อ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hayvanlarınız bekliyor. Oynamak için geri gelin ve baloncuk toplamaya devam edin!"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ھايۋانلىرىڭىز ساقلاۋاتىدۇ. قايتىپ كېلىپ داۋاملىق لوڭقا يىغىڭ!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші тварини чекають. Повертайтеся до гри та продовжуйте збирати трофеї!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے جانور انتظار کر رہے ہیں۔کھیلنے کے لیے واپس آئیں اور ٹرافیاں جمع کرتے رہیں!"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizning hayvonlar kutmoqda. O'ynash uchun qaytib keling va sovrinlar yig'ishda davom eting!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Động vật của bạn đang chờ đợi. Hãy quay lại chơi và tiếp tục thu thập chiến lợi phẩm!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的动物正在等待。回来玩并继续收集泡泡！"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Izilwane zakho zilindile. Buya uzodlala futhi uqhubeke nokuqoqa izindebe!"
          }
        }
