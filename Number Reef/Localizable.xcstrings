    "settings.characterInfo": {
      "comment": "Footnote under the character picker, explaining that a character also changes the game's colours.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke dier gee die hele spel sy eie kleurtema."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እያንዳንዱ እንስሳ ለጨዋታው በሙሉ የራሱን የቀለም ገጽታ ያመጣል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنح كل حيوان اللعبة كلها ألوانه الخاصة."
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "প্ৰতিটো জন্তুৱে গোটেই খেললৈ নিজৰ ৰঙৰ থিম আনে।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər heyvan bütün oyuna öz rəng mövzusunu gətirir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожная жывёла дадае гульні сваю каляровую тэму."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко животно дава своя цветна тема на цялата игра."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি প্রাণী পুরো খেলায় নিজের রঙের থিম আনে।"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྲོག་ཆགས་རེས་རྩེད་མོ་ཧྲིལ་པོར་རང་གི་ཁ་དོག་གི་བཟོ་ལྟ་སྟེར།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka životinja daje cijeloj igri svoju temu boja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada animal dona al joc el seu propi tema de colors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé zvíře přinese celé hře vlastní barevný motiv."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae pob anifail yn rhoi ei thema liw ei hun i'r gêm gyfan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert dyr giver hele spillet sit eget farvetema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Tier gibt dem ganzen Spiel sein eigenes Farbthema."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε ζωάκι δίνει στο παιχνίδι το δικό του χρωματικό θέμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every animal brings its own color theme to the whole game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada animal da su propio tema de color a todo el juego."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga loom annab kogu mängule oma värviteema."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Animalia bakoitzak bere kolore-gaia ematen dio joko osoari."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر حیوان، رنگ‌وبوی خودش را به کل بازی می‌دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen eläin tuo koko peliin oman väriteemansa."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvørt dýr gevur øllum spælinum sítt egna litaevni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque animal donne son propre thème de couleurs à tout le jeu."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugann gach ainmhí a théama dathanna féin don chluiche ar fad."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada animal dálle ao xogo o seu propio tema de cores."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક પ્રાણી આખી રમતમાં પોતાનો રંગ લાવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל חיה מעניקה למשחק כולו ערכת צבעים משלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर जानवर पूरे खेल को अपना रंग देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka životinja cijeloj igri daje svoju temu boja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden állat saját színvilágot ad az egész játéknak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր կենդանի ամբողջ խաղին տալիս է իր գունային ձևավորումը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap hewan memberi tema warna sendiri pada seluruh permainan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert dýr gefur öllum leiknum sitt eigið litaþema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni animale dà a tutto il gioco il proprio tema di colori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動物ごとに、ゲーム全体の色テーマが変わります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეული ცხოველი მთელ თამაშს საკუთარ ფერთა თემას აძლევს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр жануар бүкіл ойынға өз түс тақырыбын береді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សត្វនីមួយៗផ្តល់ពណ៌រចនាប័ទ្មផ្ទាល់ខ្លួនដល់ហ្គេមទាំងមូល។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಪ್ರಾಣಿಯೂ ಇಡೀ ಆಟಕ್ಕೆ ತನ್ನದೇ ಬಣ್ಣದ ಥೀಮ್ ನೀಡುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동물마다 게임 전체에 자기만의 색 테마를 더해요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສັດແຕ່ລະໂຕມີຊຸດສີຂອງຕົນເອງສຳລັບທັງເກມ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvienas gyvūnas visam žaidimui suteikia savo spalvų temą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katrs dzīvnieks visai spēlei piešķir savu krāsu motīvu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секое животно ѝ дава своја тема со бои на целата игра."
