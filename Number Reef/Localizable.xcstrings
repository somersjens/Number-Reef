    "notif.animal.body %@": {
      "comment": "Push notification body when a new animal is nearly earned. The argument is the animal's name.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Verdien nog 'n paar trofeë om hierdie dier te ontsluit! 🐼"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ይህን እንስሳ ለመክፈት ጥቂት ተጨማሪ ዋንጫዎችን ያግኙ! 🐼"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: احصل على المزيد من الجوائز لفتح هذا الحيوان! 🐼"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: এই জন্তুটোৰ তলা খুলিবলৈ আৰু কেইটামান ট্ৰফী অৰ্জন কৰক! 🐼"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Bu heyvanın kilidini açmaq üçün daha bir neçə kubok qazanın! 🐼"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Зарабіце яшчэ некалькі трафеяў, каб разблакаваць гэтую жывёлу! 🐼"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Спечелете още няколко трофея, за да отключите това животно! 🐼"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: এই প্রাণীটিকে আনলক করতে আরও কয়েকটি ট্রফি অর্জন করুন! 🐼"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: སེམས་ཅན་འདི་ཕྱེ་ཆེད་དུ་རྟགས་མ་འགའ་ཤས་རག་རོགས། 🐼"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Zaradite još nekoliko trofeja da otključate ovu životinju! 🐼"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Guanya uns quants trofeus més per desbloquejar aquest animal! 🐼"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Získejte několik dalších trofejí a odemkněte toto zvíře! 🐼"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Enillwch ychydig mwy o dlysau i ddatgloi'r anifail hwn! 🐼"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Tjen et par trofæer mere for at låse dette dyr op! 🐼"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle noch ein paar Blasen und schalte %@ frei! 🐼"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Κερδίστε μερικά ακόμη τρόπαια για να ξεκλειδώσετε αυτό το ζώο! 🐼"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect a few more bubbles to unlock %@! 🐼"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Consigue unas burbujas más para desbloquear a %@! 🐼"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Teenige selle looma avamiseks veel mõned trofeed! 🐼"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Irabazi trofeo batzuk animalia hau desblokeatzeko! 🐼"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: برای باز کردن قفل این حیوان چند تروفی دیگر به دست آورید! 🐼"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Ansaitse muutama palkinto lisää avataksesi tämän eläimen! 🐼"
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Tjen nøkur steyp afturat fyri at læsa hetta djórið upp! 🐼"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramasse encore quelques bulles pour débloquer %@ ! 🐼"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Faigh cúpla trófaithe eile chun an t-ainmhí seo a dhíghlasáil! 🐼"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Gaña algúns trofeos máis para desbloquear este animal! 🐼"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: આ પ્રાણીને અનલૉક કરવા માટે થોડી વધુ ટ્રોફી કમાઓ! 🐼"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: הרוויחו עוד כמה גביעים כדי לפתוח את החיה הזו! 🐼"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: इस जानवर को अनलॉक करने के लिए कुछ और ट्राफियां अर्जित करें! 🐼"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Zaradite još nekoliko trofeja da otključate ovu životinju! 🐼"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Szerezz még néhány buborék, hogy feloldd ezt az állatot! 🐼"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Վաստակեք ևս մի քանի գավաթներ՝ այս կենդանուն բացելու համար: 🐼"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Hasilkan beberapa piala lagi untuk membuka kunci hewan ini! 🐼"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Fáðu þér nokkra titla í viðbót til að opna þetta dýr! 🐼"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccogli ancora qualche bolla per sbloccare %@! 🐼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: この動物のロックを解除するには、さらにいくつかのバブルを獲得してください! 🐼"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: იშოვე კიდევ რამდენიმე ტროფი ამ ცხოველის განბლოკვისთვის! 🐼"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Осы жануардың құлпын ашу үшін тағы бірнеше жүлде ұтып алыңыз! 🐼"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ទទួលបានពានរង្វាន់ពីរបីទៀតដើម្បីដោះសោសត្វនេះ! 🐼"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ಈ ಪ್ರಾಣಿಯನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಲು ಇನ್ನೂ ಕೆಲವು ಟ್ರೋಫಿಗಳನ್ನು ಗಳಿಸಿ! 🐼"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 이 동물의 잠금을 해제하려면 버블을 몇 개 더 획득하세요! 🐼"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ຮັບຮາງວັນອີກສອງສາມອັນເພື່ອປົດລັອກສັດນີ້! 🐼"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Uždirbkite dar kelis trofėjus, kad atrakintumėte šį gyvūną! 🐼"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Nopelniet vēl dažas trofejas, lai atbloķētu šo dzīvnieku! 🐼"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Заработете уште неколку трофеи за да го отклучите ова животно! 🐼"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ഈ മൃഗത്തെ അൺലോക്ക് ചെയ്യാൻ കുറച്ച് ട്രോഫികൾ കൂടി നേടൂ! 🐼"
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Энэ амьтны түгжээг тайлахын тулд хэд хэдэн цом цуглуулаарай! 🐼"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: या प्राण्याला अनलॉक करण्यासाठी आणखी काही ट्रॉफी मिळवा! 🐼"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Peroleh beberapa lagi trofi untuk membuka kunci haiwan ini! 🐼"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ဤတိရစ္ဆာန်ကိုသော့ဖွင့်ရန် နောက်ထပ်ဆုဖလားအချို့ကို ရယူလိုက်ပါ။ 🐼"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: यो जनावर अनलक गर्न केहि थप ट्रफीहरू कमाउनुहोस्! 🐼"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzamel nog een paar bubbels om %@ vrij te spelen! 🐼"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Tjen noen flere trofeer for å låse opp dette dyret! 🐼"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ଏହି ପଶୁକୁ ଖୋଲିବା ପାଇଁ ଆଉ କିଛି ଟ୍ରଫି ରୋଜଗାର କର! 🐼"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ਇਸ ਜਾਨਵਰ ਨੂੰ ਅਨਲੌਕ ਕਰਨ ਲਈ ਕੁਝ ਹੋਰ ਟਰਾਫੀਆਂ ਕਮਾਓ! 🐼"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbierz jeszcze kilka bąbelków, żeby odblokować %@! 🐼"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apanha mais umas bolhas para desbloquear %@! 🐼"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Câștigă încă câteva trofee pentru a debloca acest animal! 🐼"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собери ещё немного пузырей, чтобы открыть %@! 🐼"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: මෙම සතා අගුලු හැරීමට තවත් කුසලාන කිහිපයක් උපයන්න! 🐼"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Získajte niekoľko ďalších trofejí a odomknite toto zviera! 🐼"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Zaslužite še nekaj trofej, da odklenete to žival! 🐼"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Fitoni disa trofe të tjerë për të zhbllokuar këtë kafshë! 🐼"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Зарадите још неколико трофеја да бисте откључали ову животињу! 🐼"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Tjäna några fler troféer för att låsa upp detta djur! 🐼"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Pata vikombe vichache zaidi ili kumfungulia mnyama huyu! 🐼"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: இந்த விலங்கைத் திறக்க இன்னும் சில கோப்பைகளைப் பெறுங்கள்! 🐼"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ను తెరవడానికి మరికొన్ని ట్రోఫీలు సంపాదించు! 🐼"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: รับฟองสบู่เพิ่มอีกเล็กน้อยเพื่อปลดล็อคสัตว์ตัวนี้! 🐼"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Bu hayvanın kilidini açmak için birkaç baloncuk daha kazanın! 🐼"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: بۇ ھايۋاننىڭ قۇلۇپىنى ئېچىش ئۈچۈن يەنە بىر نەچچە لوڭقىغا ئېرىشىڭ! 🐼"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Заробіть ще кілька трофеїв, щоб розблокувати цю тварину! 🐼"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: اس جانور کو غیر مقفل کرنے کے لیے کچھ اور ٹرافیاں حاصل کریں! 🐼"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Bu hayvonning qulfini ochish uchun yana bir nechta kuboklarni yutib oling! 🐼"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Kiếm thêm một vài danh hiệu để mở khóa con vật này! 🐼"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 赢得更多泡泡来解锁这只动物！ 🐼"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Zuza ezinye izindebe ezimbalwa ukuze uvule lesi silwane! 🐼"
          }
        }
      }
    },
