    "premium.storeUnavailable": {
      "comment": "Shown when the App Store cannot be reached. Addressed to an adult.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die winkel is nie nou beskikbaar nie. Probeer asseblief later weer."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መደብሩ አሁን አይገኝም። እባክዎ ቆይተው እንደገና ይሞክሩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتجر غير متاح الآن. حاول لاحقًا."
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এতিয়া ষ্ট’ৰ উপলব্ধ নহয়। পিছত আকৌ চেষ্টা কৰা।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mağaza hazırda əlçatan deyil. Sonra yenidən cəhd et."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Крама зараз недаступная. Паспрабуй пазней."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Магазинът не е достъпен в момента. Опитай пак по-късно."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্টোর এখন পাওয়া যাচ্ছে না। পরে আবার চেষ্টা করুন।"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ད་ལྟ་ཚོང་ཁང་སྤྱོད་མི་ཐུབ། རྗེས་སུ་ཡང་བསྐྱར་ཚོད་ལྟ་བྱོས།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prodavnica trenutno nije dostupna. Pokušaj ponovo kasnije."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La botiga no està disponible ara mateix. Torna-ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obchod teď není dostupný. Zkus to prosím později."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Nid yw'r siop ar gael ar hyn o bryd. Rho gynnig arall arni nes ymlaen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Butikken er ikke tilgængelig lige nu. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Store ist gerade nicht verfügbar. Bitte versuche es später noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κατάστημα δεν είναι διαθέσιμο τώρα. Δοκίμασε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The store is not available right now. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tienda no está disponible ahora. Inténtalo de nuevo más tarde."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pood pole praegu saadaval. Proovi hiljem uuesti."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Denda ez dago erabilgarri orain. Saiatu berriro geroago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فروشگاه فعلاً در دسترس نیست. بعداً دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauppa ei ole juuri nyt käytettävissä. Yritä myöhemmin uudelleen."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Handilin er ikki tøkur beint nú. Royn aftur seinni."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La boutique n’est pas disponible pour le moment. Réessaie plus tard."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl an siopa ar fáil anois. Bain triail eile as ar ball."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A tenda non está dispoñible agora. Téntao de novo máis tarde."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હમણાં સ્ટોર ઉપલબ્ધ નથી. કૃપા કરીને પછી ફરી પ્રયત્ન કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החנות אינה זמינה כרגע. נסו שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोर अभी उपलब्ध नहीं है। बाद में फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trgovina trenutačno nije dostupna. Pokušaj ponovno poslije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az áruház most nem érhető el. Próbáld újra később."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խանութն այժմ հասանելի չէ։ Փորձեք ավելի ուշ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Toko sedang tidak tersedia. Coba lagi nanti."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Verslunin er ekki tiltæk núna. Reyndu aftur síðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il negozio non è disponibile ora. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はストアを使えません。あとでもう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მაღაზია ახლა მიუწვდომელია. მოგვიანებით სცადე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дүкен қазір қолжетімсіз. Кейінірек қайталап көр."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ហាងមិនអាចប្រើបានឥឡូវនេះទេ។ សូមព្យាយាមម្ដងទៀតពេលក្រោយ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಂಗಡಿ ಈಗ ಲಭ್ಯವಿಲ್ಲ. ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 스토어를 이용할 수 없어요. 나중에 다시 시도해 주세요."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕອນນີ້ຮ້ານຄ້າບໍ່ພ້ອມ. ກະລຸນາລອງໃໝ່ພາຍຫຼັງ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parduotuvė dabar nepasiekiama. Bandyk dar kartą vėliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Veikals pašlaik nav pieejams. Lūdzu, mēģini vēlāk."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продавницата моментално не е достапна. Обиди се повторно подоцна."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്റ്റോർ ഇപ്പോൾ ലഭ്യമല്ല. പിന്നീട് വീണ്ടും ശ്രമിക്കൂ."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дэлгүүр одоогоор ажиллахгүй байна. Дараа дахин оролдоорой."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोअर सध्या उपलब्ध नाही. कृपया नंतर पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedai tidak tersedia sekarang. Cuba lagi nanti."
          }
        },
        "my": {
          "stringUnit": {
