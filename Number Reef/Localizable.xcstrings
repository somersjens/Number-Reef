        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siêu thưởng kéo dài đến khi bạn chạm đáp án sai. Khi đó bạn chỉ mất nửa mạng. Chúc may mắn!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "超级奖励会持续到你撞上错误答案。之后只会失去半条命。加油！"
