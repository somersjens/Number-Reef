        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Буруу хариутай бөмбөлөг мөргөх хүртэл супер бонус үргэлжилнэ. Тэгэхэд хагас амь л хасагдана. Амжилт!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चुकीचे उत्तर लागेपर्यंत सुपर बोनस चालू राहील. मग फक्त अर्धा जीव जाईल. शुभेच्छा!"
          }
