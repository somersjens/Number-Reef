    "levelIntro.tables.intro": {
      "comment": "First line of the level intro card for Tables. Emphasise the operation with Markdown **bold**, wherever it falls in your sentence.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Somme waar jy \\*\\*vermenigvuldig\\*\\*."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "**የምታባዛባቸው** ስሌቶች።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسائل **تضرب** فيها."
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "য’ত তুমি **পূৰণ** কৰা অংক।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vurma** misalları."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прыклады, дзе трэба **множыць**."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачи, в които **умножаваш**."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব অঙ্কে **গুণ** করো।"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "**སྒྱུར་བའི** རྩིས།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaci gdje **množiš**."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumes on **multipliques**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příklady, kde **násobíš**."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Symiau lle rwyt ti’n **lluosi**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Regnestykker, hvor du **ganger**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben, bei denen du **multiplizierst**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ασκήσεις όπου **πολλαπλασιάζεις**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sums where you **multiply**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumas en las que **multiplicas**."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehted, kus sa **korrutad**."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "\\*\\*Biderketak\\*\\* dituzten eragiketak."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تمرین‌هایی که در آن **ضرب** می‌کنی."
          }
        },
        "fi": {
