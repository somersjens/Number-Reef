    "premium.feature.noAds.subtitle": {
      "comment": "Explains the third Premium selling point in one line.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel heeltemal sonder onderbrekings."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ያለምንም መቋረጥ ተጫወት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العب بلا أي مقاطعات."
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো বাধা নোহোৱাকৈ খেলা।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamilə fasiləsiz oyna."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гуляй без перапынкаў."
          }
        },
        "bg": {
