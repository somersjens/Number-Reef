    "parentGate.tapInstruction %lld %@": {
      "comment": "Instruction in the adult check: tap a named shape a number of times. First argument is the number of taps, second the shape's name from parentGate.shape.*.",
      "extractionState": "manual",
      "localizations": {
        "af": {
