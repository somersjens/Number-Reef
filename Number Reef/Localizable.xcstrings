            "state": "translated",
            "value": "Mereu exerciții noi pentru exersat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда много новых примеров для тренировки."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "පුහුණු වීමට හැමවිටම අලුත් ගණන් ඇති තරම්."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy dosť nových príkladov na tréning."
          }
        },
        "sl": {
          "stringUnit": {
