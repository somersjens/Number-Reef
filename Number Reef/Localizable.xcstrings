    "goal.promptDaily": {
      "comment": "Question in the play-goal sheet when the daily period is selected. Addressed to the player.",
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel minute wil jy elke dag speel?"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በቀን ስንት ደቂቃ መጫወት ትፈልጋለህ?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم دقيقة تريد أن تلعب يوميًا؟"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "দিনে কিমান মিনিট খেলিব খোজা?"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gündə neçə dəqiqə oynamaq istəyirsən?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Колькі хвілін ты хочаш гуляць штодня?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колко минути искаш да играеш на ден?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদিন কত মিনিট খেলতে চাও?"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཉིན་རེར་སྐར་མ་ག་ཚོད་རྩེ་འདོད་དམ།"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko minuta želiš igrati dnevno?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quants minuts vols jugar cada dia?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik minut chceš hrát každý den?"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Sawl munud wyt ti eisiau chwarae bob dydd?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange minutter vil du spille om dagen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Minuten möchtest du täglich spielen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσα λεπτά θέλεις να παίζεις κάθε μέρα;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many minutes a day would you like to play?"
